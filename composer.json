{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.0.2",
        "ext-curl": "*",
        "ext-json": "*",
        "barryvdh/laravel-translation-manager": "^0.6.8",
        "doctrine/dbal": "^3.4",
        "firebase/php-jwt": "^6.11",
        "goodday/common": "^0.1.16",
        "goodday/goodwall": "^0.1.3",
        "goodday/mobile-apps": "^0.1.0",
        "goodday/offers-api": "1.x",
        "goodday/postbacks": "^0.1.2",
        "guzzlehttp/guzzle": "^7.2",
        "jenssegers/agent": "^2.6",
        "laravel/framework": "10.48",
        "laravel/sanctum": "3.3",
        "laravel/telescope": "4.17",
        "laravel/tinker": "^2.7",
        "nordigen/nordigen-php": "^1.1",
        "nunomaduro/collision": "7.0",
        "opcodesio/log-viewer": "^1.6",
        "phpunit/phpunit": "10.0",
        "spatie/laravel-ignition": "2.0",
        "spatie/laravel-permission": "6.0",
        "spatie/laravel-sitemap": "^6.2"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9.1",
        "laravel-lang/attributes": "^2.0",
        "laravel-lang/lang": "^12.0",
        "laravel-lang/publisher": "^14.3",
        "laravel/breeze": "^1.13",
        "laravel/pint": "^1.0",
        "laravel/sail": "^1.0.1",
        "mockery/mockery": "^1.4.4"
    },
    "autoload": {
        "files": [
            "app/helpers.php"
        ],
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "policy": {
            "advisories": {
                "block": false
            },
            "malware": {
                "block": false
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "composer",
            "url": "https://composer.goodday.group"
        }
    ]
}
